{
  "name": "toolfolk-for-dsh",
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "description": "DSH 3D AI 工作室：把插件与模型的调用过程可视化成 3D 办公室（六固定岗位 + 思维流气泡 + 交付纸）",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "3d",
    "three",
    "visualization",
    "dsh-plugin",
    "threejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkl22492-star/Toolfolk-for-DSH.git"
  },
  "homepage": "https://github.com/zkl22492-star/Toolfolk-for-DSH#readme",
  "bugs": {
    "url": "https://github.com/zkl22492-star/Toolfolk-for-DSH/issues"
  },
  "author": "浊客er",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src/host.mjs",
    "src/shared",
    "src/client",
    "lib/client.js",
    "cordis.patch.yml",
    "assets/3d/v2/studio.glb",
    "assets/art/studio-v1",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "assets:build": "node scripts/build-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "client:build": "node scripts/build-client.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "state:replay": "node scripts/replay-state.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "0.180.0"
  }
}
