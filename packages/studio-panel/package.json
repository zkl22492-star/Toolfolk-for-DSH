{
  "name": "dsh-studio-panel",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "DSH 3D AI 工作室：把插件与模型的调用过程可视化成 3D 办公室（六固定岗位 + 思维流气泡 + 交付纸）",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src/host.mjs",
    "src/shared",
    "src/client",
    "lib/client.js",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "prepare": "node ../../scripts/prepare-package.mjs",
    "prepack": "node ../../scripts/prepare-package.mjs"
  }
}
